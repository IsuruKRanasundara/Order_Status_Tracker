generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Order {
  id        String       @id
  status    String
  updatedAt DateTime
  events    OrderEvent[]
}

model OrderEvent {
  eventId   String   @id
  orderId   String
  status    String
  timestamp DateTime

  order Order @relation(fields: [orderId], references: [id])
}